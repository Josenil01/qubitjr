{
    "name": "ScratchJr",
    "productName": "ScratchJr",
    "version": "1.3.2",
    "description": "ScratchJr Web Edition",
    "scripts": {
        "start": "npm run dev",
        "dev": "concurrently \"npm run backend\" \"npm run frontend:vite\"",
        "dev:http": "concurrently \"npm run backend\" \"npm run frontend\"",
        "backend": "cd backend && npm start",
        "backend:dev": "cd backend && npm run dev",
        "frontend": "npx http-server src/app -p 3000",
        "frontend:vite": "vite --host",
        "build": "vite build",
        "preview": "vite preview",
        "install:all": "npm install && cd backend && npm install && cd ..",
        "lint": "eslint src --color"
    },
    "keywords": [],
    "author": "ScratchJr - Open Source Community Port",
    "license": "MIT",
    "app-copyright": "Copyright (c) 2016, MIT",
    "eslintConfig": {
        "extends": "eslint-config-airbnb",
        "parserOptions": {
            "ecmaVersion": 6,
            "sourceType": "module",
            "ecmaFeatures": {}
        },
        "rules": {
            "no-use-before-define": 0,
            "max-len": 0,
            "no-multi-spaces": 0,
            "no-param-reassign": 0,
            "indent": 0,
            "padded-blocks": 0,
            "class-methods-use-this": 0,
            "trailing-spaces-not-allowed": 0,
            "vars-on-top": 0,
            "no-trailing-spaces": 0,
            "no-multiple-empty-lines": 0,
            "no-continue": 0,
            "no-plusplus": 0,
            "spaced-comment": 0,
            "no-var": 0,
            "eqeqeq": 0,
            "prefer-template": 0,
            "camelcase": 0,
            "space-before-blocks": 0,
            "quote-props": 0,
            "quotes": [
                "error",
                "single",
                {
                    "allowTemplateLiterals": true
                }
            ],
            "comma-dangle": 0,
            "default-case": 0,
            "no-useless-escape": 0,
            "yoda": 0,
            "no-useless-return": 0,
            "space-before-function-paren": 0,
            "one-var-declaration-per-line": 0,
            "object-curly-spacing": 0,
            "prefer-const": 0,
            "func-call-spacing": 0,
            "no-tabs": 0,
            "func-names": 0,
            "prefer-arrow-callback": 0,
            "no-mixed-spaces-and-tabs": 0,
            "no-mixed-operators": 0,
            "no-unused-vars": [
                2,
                {
                    "args": "after-used",
                    "varsIgnorePattern": "^_"
                }
            ],
            "no-restricted-syntax": 0,
            "no-nested-ternary": 0,
            "import/extensions": 0,
            "no-useless-concat": 0,
            "no-unneeded-ternary": [
                "error",
                {
                    "defaultAssignment": true
                }
            ],
            "one-var": 0,
            "object-shorthand": 0,
            "operator-assignment": 0,
            "no-lonely-if": 0,
            "no-else-return": 0,
            "no-shadow": 0,
            "no-undef-init": 0,
            "radix": 0,
            "no-bitwise": 0,
            "no-restricted-properties": [
                0,
                {
                    "object": "Math",
                    "property": "pow",
                    "message": "Use the exponentiation operator (**) instead."
                }
            ],
            "guard-for-in": 0
        },
        "globals": {
            "AndroidInterface": true,
            "window": true,
            "WebKitCSSMatrix": true,
            "webkitAudioContext": true,
            "require": true
        },
        "env": {
            "browser": true,
            "node": true
        },
        "eslintIgnore": [
            "./src/app/src/snap/snap.svg-min.js"
        ]
    },
    "dependencies": {
        "hoek": "^4.2.1",
        "intl": "^1.2.5",
        "intl-messageformat": "^2.2.0",
        "jszip": "^3.1.5",
        "snapsvg": "^0.5.1",
        "sql.js": "^0.4.0",
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "dotenv": "^16.3.1",
        "@supabase/supabase-js": "^2.39.8",
        "pg": "^8.11.3"
    },
    "devDependencies": {
        "babel-plugin-transform-async-to-generator": "^6.24.1",
        "babel-preset-env": "^1.6.1",
        "babel-preset-react": "^6.24.1",
        "concurrently": "^8.0.0",
        "eslint": "^3.19.0",
        "eslint-config-airbnb": "^15.1.0",
        "eslint-plugin-import": "^2.11.0",
        "eslint-plugin-jsx-a11y": "^5.1.1",
        "eslint-plugin-react": "^7.7.0",
        "http-server": "^14.1.0",
        "vite": "^7.3.1"
    }
}
