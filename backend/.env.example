# Backend Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Lista separada por virgula para origens adicionais permitidas.
# Em producao, apenas essas origens serao aceitas.
# Exemplo: CORS_ALLOWED_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com
CORS_ALLOWED_ORIGINS=

# Supabase Configuration
# Obtém em: https://app.supabase.com -> seu projeto -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_MEDIA_BUCKET=media

# Auth
# mock  → tokens fixos para dev (dev-user-a → usr_001 | dev-user-b → usr_002 | dev-teacher-a → prof_001)
# production → lê header injetado pelo API Gateway (ver JWT_USER_HEADER)
AUTH_MODE=mock
# Header que o API Gateway/Proxy injeta com o id_usuario (apenas em production)
JWT_USER_HEADER=x-user-id

# HelloYotta (plataforma mãe — fonte da verdade de turma/professor/aluno)
# mock → usa roster fixo em services/helloyotta.js, sem chamar a API real
# live → chama os endpoints reais em HELLOYOTTA_API_URL (contrato confirmado
# por e-mail 2026-08): GET /api/qubit/classrooms/:turmaId/roster (Bearer do
# professor) e POST /api/auth/verify-token (verificação do token do aluno).
HELLOYOTTA_MODE=mock
HELLOYOTTA_API_URL=
# Chave dedicada ao QubitJr (diferente da QUBIT_API_KEY da integração "Qubit"
# original de progresso do aluno — não confundir). Bearer em
# POST /api/auth/verify-token (verificação do token do aluno). O roster
# (GET /api/qubit/classrooms/:turmaId/roster) usa o token do PROFESSOR como
# Bearer, não esta chave — ver services/helloyotta.js.
QUBITJR_API_KEY=
# Segredo HMAC exclusivo do token do PROFESSOR (services/identity.js). NÃO é
# usado pro token do aluno. Sem esta variável configurada, o backend aceita
# token de professor sem checar assinatura — só ok fora de produção.
QUBITJR_JWT_SECRET=

# Sentido OPOSTO das duas chaves acima: esta é a chave que a HelloYotta usa
# como Bearer pra CHAMAR a gente, não o contrário. Protege
# GET /api/public/students/:studentId/time-spent (routes/share.js) — tempo
# total do aluno na plataforma, puxado pelo backend deles. Sem esta variável
# configurada, o endpoint responde 503 (desligado por padrão até ter uma
# chave real combinada com o time da HelloYotta).
HELLOYOTTA_INBOUND_API_KEY=

# URL do webhook da HelloYotta pra notificar o cadastro de uma missão
# (POST /api/assignments/register → services/helloyotta.js#notifyAssignmentRegistered).
# Diferente das chaves acima: este endpoint AINDA NÃO foi confirmado com o
# time da HelloYotta (não é contrato fechado como roster/verify-token). Sem
# esta variável configurada, a notificação vira no-op silencioso — o
# cadastro da missão continua funcionando normalmente pro professor, só não
# avisa a HelloYotta ainda.
HELLOYOTTA_ASSIGNMENT_WEBHOOK_URL=

# Logging (opcional)
DEBUG=false
