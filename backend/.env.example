# Backend Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Lista separada por virgula para origens adicionais permitidas.
# Em producao, apenas essas origens serao aceitas.
# Exemplo: CORS_ALLOWED_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com
CORS_ALLOWED_ORIGINS=

# Supabase Configuration
# Obtém em: https://app.supabase.com -> seu projeto -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_MEDIA_BUCKET=media

# Logging (opcional)
DEBUG=false
