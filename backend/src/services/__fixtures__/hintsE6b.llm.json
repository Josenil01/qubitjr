{
  "intro": "🚀 Vamos fazer a Ruby pular e crescer com o Allan?",
  "hints": [
    {"text": "Que tal colocar o cenário do Bosque?", "when": {"type": "scene_missing", "sceneMd5": "Woods.svg", "sceneOccurrence": 1}},
    {"text": "Faça a Ruby dizer 'Oi' quando a bandeira verde for clicada.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["say"], "scriptRef": "S1", "blockIndices": [1]}},
    {"text": "Depois faça ela pular 2 passos.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["hop"], "scriptRef": "S1", "blockIndices": [2]}},
    {"text": "Agora faça ela pular 4 passos.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["hop"], "scriptRef": "S1", "blockIndices": [2]}},
    {"text": "Faça ela andar 1 passo, 3 vezes, usando o bloco de repita.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["repeat", "forward"], "scriptRef": "S1", "blockIndices": [4, 5, 6]}},
    {"text": "Por fim, ela anda 5 passos.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["forward"], "blockArgs": {"forward": 99}}},
    {"text": "Coloque o Allan aqui.", "when": {"type": "character_missing", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Allan.svg"}},
    {"text": "Quando clicar no Allan, ele manda a mensagem azul.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Allan.svg", "blockTypes": ["message"], "scriptRef": "S1", "blockIndices": [1], "expected": {"trigger": "onflag", "triggerArg": null, "script": [{"type": "message", "num": 42}], "covered": [0]}}},
    {"text": "Quando a Ruby receber a mensagem verde, ela cresce 4.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["grow"], "scriptRef": "S3", "blockIndices": [1]}},
    {"text": "Quando a Ruby receber a mensagem azul, ela cresce 2.", "when": {"type": "character_missing_block_type", "sceneMd5": "Woods.svg", "sceneOccurrence": 1, "characterMd5": "HY-Ruby.svg", "blockTypes": ["grow"]}},
    {"text": "A Ruby precisa receber a mensagem azul.", "when": {"type": "message_not_received", "messageName": "azul"}}
  ]
}
